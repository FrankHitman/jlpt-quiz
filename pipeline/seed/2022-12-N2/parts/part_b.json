 "explanations": [
  {
   "section_code": "lang_reading",
   "number_in_section": 31,
   "key_point": "〜かけだ（N2）",
   "analysis_zh": "正解是 2「読み」。「Vます＋かけだ」表示動作做到一半、未完成的狀態（N2）。「読みかけだった3冊の本」＝看到一半的三本書，後文「全部讀到最後」與之呼應。",
   "distractors": [
    {
     "option": "1",
     "why_wrong": "「読むかけだ」接續錯誤，かけだ前面須接動詞ます形去ます。"
    },
    {
     "option": "3",
     "why_wrong": "「読んでかけだ」接續錯誤。"
    },
    {
     "option": "4",
     "why_wrong": "「読んだかけだ」接續錯誤；且た形表完成，與「未完成」矛盾。"
    }
   ],
   "evidence": null,
   "option_readings": {
    "1": "よむ",
    "2": "よみ",
    "3": "よんで",
    "4": "よんだ"
   },
   "option_meanings": {
    "1": "讀（原形，不合接續）",
    "2": "讀（ます形，接かけだ表未完成）",
    "3": "讀了（て形，不合接續）",
    "4": "讀完了（た形，表完成）"
   }
  },
  {
   "section_code": "lang_reading",
   "number_in_section": 32,
   "key_point": "むしろ（N2）",
   "analysis_zh": "正解是 1「むしろ」。「むしろ」表「倒不如說、寧可」，用於修正前文、提出更貼切的說法。此處修正「不討厭」為「不如說是喜歡的蔬菜之一」。",
   "distractors": [
    {
     "option": "2",
     "why_wrong": "「いったい」表「到底」，用於疑問，與肯定句不合。"
    },
    {
     "option": "3",
     "why_wrong": "「そのうち」表「不久之後」，表時間，與語境無關。"
    },
    {
     "option": "4",
     "why_wrong": "「ちょっと」後須接否定才表「一點也不」，此處無否定，不合。"
    }
   ],
   "evidence": null,
   "option_readings": {},
   "option_meanings": {}
  },
  {
   "section_code": "lang_reading",
   "number_in_section": 33,
   "key_point": "〜に向けて（N2）",
   "analysis_zh": "正解是 4「に向けて」。「Nに向けて」表「以…為目標、朝著…」，此處「以明年3月完工為目標」工程順利推進，語境契合。",
   "distractors": [
    {
     "option": "1",
     "why_wrong": "「を込めて」表「包含在內」，與完工目標無關。"
    },
    {
     "option": "2",
     "why_wrong": "「に際して」表「值此…之際」，用於正式場合，不合。"
    },
    {
     "option": "3",
     "why_wrong": "「を通じて」表「通過…（手段/期間）」，不合。"
    }
   ],
   "evidence": null,
