 "explanations": [
  {
   "section_code": "lang_reading",
   "number_in_section": 1,
   "key_point": "漢字讀音・拡充",
   "analysis_zh": "正解是 4（かくじゅう）。「拡充」讀作 かくじゅう，意為「擴充、擴大」。「販売部門を拡充した」即擴充了銷售部門。",
   "distractors": [
    {
     "option": "1",
     "why_wrong": "「こうじゅ」不是「拡充」的讀音。"
    },
    {
     "option": "2",
     "why_wrong": "「かくじゅ」促音位置錯誤，正確是 かくじゅう。"
    },
    {
     "option": "3",
     "why_wrong": "「こうじゅう」長音位置錯誤，應為 かくじゅう。"
