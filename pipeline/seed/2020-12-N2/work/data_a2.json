  {
   "section_code": "lang_reading",
   "number_in_section": 11,
   "key_point": "語形成・接頭辞「再」",
   "analysis_zh": "正解是 3「再」。「再提出（さいていしゅつ）」是重新提交；「再」作接頭辭表「再次」，如再利用（さいりよう）、再開発（さいかいはつ）、再放送（さいほうそう）、再就職（さいしゅうしょく）。",
   "distractors": [
    {
     "option": "1",
     "why_wrong": "復（ふく）作接尾表「多個」，如複数（ふくすう）；不能與「提出」組合成「再次提交」"
    },
    {
     "option": "2",
     "why_wrong": "改（かい）表悔改、修改、改正，如改訂（かいてい）、改革（かいかく）；「改提出」不是固定詞"
    },
    {
     "option": "4",
     "why_wrong": "補（ほ）作結尾詞表官職，如警部補（けいぶほ）、判事補（はんじほ）；不能表「再次」"
    }
   ],
   "evidence": null,
   "option_readings": {
    "1": "ふく",
    "2": "かい",
    "3": "さい",
    "4": "ほ"
   },
   "option_meanings": {
    "1": "多個（複数）",
    "2": "悔改；修改",
    "3": "再次；重新",
    "4": "（官職結尾，如警部補）"
   }
  },
  {
   "section_code": "lang_reading",
   "number_in_section": 12,
   "key_point": "語形成・「都会育ち」",
   "analysis_zh": "正解是 1「育ち」。「都会育ち（とかいそだち）」是在城市長大的；「育ち（そだち）」是教育、生長的環境，如「生まれは成都、育ちは上海です」生於成都長於上海。",
   "distractors": [
    {
     "option": "2",
     "why_wrong": "過ごし（すごし）是「過、度過」，如「楽しい毎日を過ごしている」過著開心的每天；「都会過ごし」不是固定搭配"
    },
    {
     "option": "3",
     "why_wrong": "始まり（はじまり）是開始，如「授業の始まりを知らせるベル」上課鈴聲；不能接在「都会」後表屬性"
    },
    {
     "option": "4",
     "why_wrong": "生き（いき）是活、生活，如「今を生きるべきだ」應該活在當下；「都会生き」不成立"
    }
   ],
   "evidence": null,
