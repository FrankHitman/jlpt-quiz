   "number_in_section": 31,
   "key_point": "〜さえ（N2）",
   "analysis_zh": "正解是 3「さえ」。「〜さえ〜ない」表示「連…都…不」，強調連最低限度的事都做不到。「怖くて水に顔をつけることさえできなかった」＝因為害怕，連把臉放進水裡都做不到，符合語境。",
   "distractors": [
    {
     "option": "1",
     "why_wrong": "「なら」表假定（如果…的話），不合。"
    },
    {
     "option": "2",
     "why_wrong": "「ほど」表程度（…到…地步），此處不是比較程度。"
    },
    {
     "option": "4",
     "why_wrong": "「ばかり」表「只、光」，不合語境。"
    }
   ],
   "evidence": null,
   "option_readings": {
    "1": "なら",
    "2": "ほど",
    "3": "さえ",
    "4": "ばかり"
   },
   "option_meanings": {
    "1": "如果…的話",
    "2": "…到…地步",
    "3": "連…都",
    "4": "只、光"
   }
