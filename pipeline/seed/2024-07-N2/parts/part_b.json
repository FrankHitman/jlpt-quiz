  "explanations": [
    {
      "section_code": "lang_reading",
      "number_in_section": 31,
      "key_point": "〜なんか（N2）",
      "analysis_zh": "正解是 4「なんか」。「名詞＋なんか」表示自謙、自嘲，相當於「像我這種…」。山谷先生多次奪冠卻說「私なんかまだまだですよ」（像我還差得遠呢），是典型的自謙表達。",
      "evidence": null,
      "distractors": [
        {
          "option": "1",
          "why_wrong": "「まで」表範圍的終點（到…為止），不合自謙語境。"
        },
        {
          "option": "2",
          "why_wrong": "「さえ」表極端例示（連…都），「私さえまだまだ」語感不自然。"
        },
        {
          "option": "3",
          "why_wrong": "「ばかり」表限定（只、淨是），不合自謙語境。"
        }
      ],
      "option_readings": {
        "1": "まで",
        "2": "さえ",
        "3": "ばかり",
        "4": "なんか"
      },
      "option_meanings": {
        "1": "到…為止",
        "2": "連…都、甚至",
        "3": "只、淨是",
        "4": "像…這種（自謙、自嘲）"
      }
    },
    {
      "section_code": "lang_reading",
      "number_in_section": 32,
      "key_point": "疑問詞＋か（どれほど〜のだろうか）（N2）",
      "analysis_zh": "正解是 2「どれほど」。「どれほど〜のだろうか」＝「有多少…呢」，對數量表示疑問推測。",
      "evidence": null,
      "distractors": [
        {
          "option": "1",
          "why_wrong": "「どうも」表「總覺得…」或「怎麼也…」，後不接「のだろうか」表數量的疑問。"
        },
        {
          "option": "3",
          "why_wrong": "「どうしても」＝無論如何也…，後接意志性表達，不接表推測的「のだろうか」。"
        },
        {
          "option": "4",
          "why_wrong": "「どんなに」＝無論多麼…，多與「ても」連用，不表「有多少」。"
        }
      ],
      "option_readings": {
        "1": "どうも",
        "2": "どれほど",
        "3": "どうしても",
        "4": "どんなに"
      },
      "option_meanings": {
        "1": "總覺得；怎麼也",
        "2": "有多少、到何種程度",
        "3": "無論如何也",
        "4": "無論多麼"
      }
    },
    {
      "section_code": "lang_reading",
      "number_in_section": 33,
      "key_point": "〜といった（N2）",
      "analysis_zh": "正解是 3「といった」。「AやBといったC」＝「像A、B這樣的C」，表舉例說明，後接上位概念（夏の野菜）。",
      "evidence": null,
      "distractors": [
        {
          "option": "1",
          "why_wrong": "「とする」＝作為…／假定…，不合舉例語境。"
        },
        {
          "option": "2",
          "why_wrong": "「に関する」＝關於…，後接主題，不合。"
        },
